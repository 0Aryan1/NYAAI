# NYAAI configuration (LLD §15.4). Copy to .env and fill in. Never commit .env.
NODE_ENV=development
APP_ROLE=api
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database (local docker: infra/docker-compose.yml). App/worker connect as RLS-bound roles.
DATABASE_URL=postgres://nyaai_app:nyaai_app_dev@localhost:54329/nyaai
DATABASE_URL_WORKER=postgres://nyaai_worker:nyaai_worker_dev@localhost:54329/nyaai
DATABASE_URL_LIBRARY=postgres://nyaai_library:nyaai_library_dev@localhost:54329/nyaai
DATABASE_URL_MIGRATE=postgres://nyaai_owner:nyaai_owner_dev@localhost:54329/nyaai

REDIS_URL=redis://localhost:63799

# Object storage: SeaweedFS locally, R2 in the pilot, S3 ap-south-1 in production
S3_ENDPOINT=http://localhost:19000
S3_REGION=ap-south-1
S3_BUCKET=nyaai-dev
S3_ACCESS_KEY_ID=nyaai
S3_SECRET_ACCESS_KEY=nyaai-s3-dev

# Sign-in. Google client not created yet; DEV_LOGIN works only when NODE_ENV=development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=cnlu.ac.in
DEV_LOGIN=true
# Development only: accept Google accounts without a Workspace domain (e.g. Gmail) when testing locally.
GOOGLE_SKIP_HD_CHECK=false

# Limits per minute (LLD §17.4). The browser journeys raise both; real teachers keep these.
RATE_LIMIT_PER_MIN=60
SIGNIN_LIMIT_PER_MIN=5
# Request bodies: JSON, and judgment PDFs the library editor uploads (MB).
JSON_BODY_LIMIT=1mb
JUDGMENT_UPLOAD_MAX_MB=50

# Browser journeys (E2E) only: scripted fake Claude and Voyage, no outside lookups. Never in production.
E2E_FAKE_AI=false
# BullMQ key prefix; the E2E run uses its own so a developer's worker never takes its jobs.
QUEUE_PREFIX=bull

# Process tuning (defaults shown). Database pool sizes:
DB_POOL_API=10
DB_POOL_WORKER=8
DB_POOL_LIBRARY=4
# Worker: jobs at once per queue, and how long a job may hold its lock (ms).
CONCURRENCY_BUILD=3
CONCURRENCY_RESEARCH=2
CONCURRENCY_LEARN=2
CONCURRENCY_CHECK=8
CONCURRENCY_INGEST=4
JOB_LOCK_MS=120000
# Inside a lecture build or research run: the most time spent looking up missing sources, per part (ms).
LOOKUP_BUDGET_MS=120000

# 32+ random bytes each (e.g. `openssl rand -base64 48`)
SESSION_SECRET=
CSRF_SECRET=

# AI and data providers (paste your keys into .env only)
ANTHROPIC_API_KEY=
MODEL_WRITER=claude-sonnet-5-5
MODEL_CHECKER=claude-haiku-5-5
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-law-2
VOYAGE_RERANK_MODEL=rerank-2.5
RERANK_MIN_SCORE=0.5
# Largest Voyage embedding request in tokens; ~8000 while the account is on reduced (no-card) limits.
VOYAGE_MAX_BATCH_TOKENS=60000
INDIAN_KANOON_TOKEN=
KANOON_CACHE_DAYS=30
PERPLEXITY_API_KEY=
WEB_ALLOWLIST=gov.in,nic.in,sci.gov.in
# The longest one AI request / one storage request may take (ms).
ANTHROPIC_TIMEOUT_MS=300000
S3_TIMEOUT_MS=60000
# Provider addresses: leave empty for the public address (set only for a proxy or a test double).
KANOON_BASE_URL=
VOYAGE_BASE_URL=
PERPLEXITY_BASE_URL=
INDIA_CODE_BASE_URL=
ESCR_BASE_URL=

# Reserved, not wired yet (week 2+): monitoring and a backup reranker.
COHERE_API_KEY=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=

# Week-2 features ship dark: coach,merge_split,web_search,whats_new,thorough_research
FEATURE_FLAGS=
# Each teacher's monthly AI budget is set per teacher in the database (default US$12, migration 0001).

# Web app (Vite dev server; read by apps/web/vite.config.ts, not by the API)
WEB_PORT=5173
API_ORIGIN=http://localhost:4000
