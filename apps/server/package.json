{
  "name": "@nyaai/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "tsx watch --clear-screen=false src/main.api.ts",
    "dev:worker": "tsx watch --clear-screen=false src/main.worker.ts",
    "start:api": "tsx src/main.api.ts",
    "start:worker": "tsx src/main.worker.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "ingest:source": "tsx scripts/ingest-source.ts",
    "library": "tsx scripts/library.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@mozilla/readability": "^0.6.0",
    "@nyaai/checker-rules": "workspace:*",
    "@nyaai/db": "workspace:*",
    "@nyaai/legal": "workspace:*",
    "@nyaai/prompts": "workspace:*",
    "@nyaai/shared": "workspace:*",
    "bullmq": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "jsdom": "^29.1.1",
    "jszip": "3.10.2",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pptxgenjs": "4.0.1",
    "rate-limiter-flexible": "^11.5.0",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  }
}
