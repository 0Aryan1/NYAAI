{
  "name": "@nyaai/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "tsx watch --clear-screen=false src/main.api.ts",
    "dev:worker": "tsx watch --clear-screen=false src/main.worker.ts",
    "start:api": "tsx src/main.api.ts",
    "start:worker": "tsx src/main.worker.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nyaai/db": "workspace:*",
    "@nyaai/shared": "workspace:*",
    "bullmq": "^6.0.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  }
}
